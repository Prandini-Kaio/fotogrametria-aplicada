# Configurações do Sistema de Fotogrametria
# Copie este arquivo para .env e configure os valores

# Caminho para o executável do COLMAP
# Exemplos:
# COLMAP_PATH=C:\COLMAP\colmap.exe
# COLMAP_PATH=C:\Program Files\COLMAP\colmap.exe
COLMAP_PATH=

# Nome da aplicação
APP_NAME=Fotogrametria aplicada

# Modo debug
DEBUG=False

# Caminho para armazenamento de imagens
IMAGE_STORAGE_PATH=./resources/output/images






